---
layout: layout.njk
pagination:
  data: slates
  size: 1
  alias: slate
permalink: "/slate/{{ slate.ymd }}/"
navCurrent: slate
eleventyComputed:
  title: "NBA slate: {{ slate.label }}"
---
{% macro scoreSide(side) -%}
{%- if side.won -%}
<strong>{{ side.name }} {{ side.score }}<span class="visually-hidden"> (winner)</span></strong>
{%- else -%}
{{ side.name }} {{ side.score }}
{%- endif -%}
{%- endmacro %}
<h1>NBA slate: {{ slate.label }}</h1>

<nav aria-label="Slate date" class="date-nav">
  <ul>
    {%- for s in slates %}
    <li>
      <a href="/slate/{{ s.ymd }}/"{% if s.ymd == slate.ymd %} aria-current="page"{% endif %}>{{ s.navLabel }}</a>
    </li>
    {%- endfor %}
  </ul>
</nav>

{% if slate.games.length == 0 %}
<p>No NBA games on this date.</p>
{% else %}
<ul class="card-grid" role="list">
  {%- for game in slate.games %}
  <li>
    <article id="game-{{ game.id }}" aria-labelledby="game-{{ game.id }}-heading" class="card">
      {% if game.finalScore %}
      {# The winner is bold, and named in words for screen readers, so the
         highlight never depends on sight alone. #}
      <h2 id="game-{{ game.id }}-heading" class="final-score">{{ scoreSide(game.finalScore.away) }} at {{ scoreSide(game.finalScore.home) }}</h2>
      {% else %}
      <h2 id="game-{{ game.id }}-heading">{{ game.heading }}</h2>
      {% endif %}
      {% if game.statusLine %}<p class="muted">{{ game.statusLine }}</p>{% endif %}

      {% if game.odds %}
      <p class="fact-lead"><strong>{{ game.odds.provider }}:</strong></p>
      <ul class="fact-list">
        {%- for item in game.odds.items %}
        <li{% if item.changed %} class="changed"{% endif %}>{{ item.text }}</li>
        {%- endfor %}
      </ul>
      {% elif not game.isFinal %}
      <p class="muted">No betting line posted yet.</p>
      {% endif %}

      {% if game.lineCheck %}
      <section aria-label="Line check: {{ game.heading }}" class="linecheck">
        <h3>Line check</h3>
        <ul class="fact-list">
          {%- for item in game.lineCheck %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        <p class="muted">Computed from recent efficiency, home court, rest, and fresh key absences, nothing else. The market knows more than this model.</p>
      </section>
      {% endif %}

      {% if game.myPick %}
      {# Saving a pick returns here (#pick-<id>); tabindex lets the browser move focus to it. #}
      <div class="my-pick" id="pick-{{ game.id }}" tabindex="-1">
        <p><strong>Your pick:</strong> {{ game.myPick.text }}</p>
        <p class="muted">{{ game.myPick.savedNote }}.{% if game.canEdit %} You can update it in the game details until tip-off.{% endif %}</p>
      </div>
      {% endif %}

      {% if game.collapseDetails %}
      {# Opened here, closed after the update form below. #}
      <details class="game-details">
        <summary>View game details{% if game.changes and game.changes.length %} ({{ game.changes.length }} {% if game.changes.length == 1 %}change{% else %}changes{% endif %} since your pick){% endif %}</summary>
        {% if game.changes and game.changes.length %}
        <div class="changes">
          <h3>Changed since your pick</h3>
          <ul class="fact-list">
            {%- for c in game.changes %}
            <li>{{ c }}</li>
            {%- endfor %}
          </ul>
        </div>
        {% endif %}
      {% endif %}

      {% if game.recap %}
      <section aria-label="How it happened: {{ game.heading }}" class="recap">
        <h3>How it happened</h3>
        {% if game.recap.analysis %}<p>{{ game.recap.analysis }}</p>{% endif %}
        {% if game.recap.factors.length > 0 %}
        <ul>
          {%- for f in game.recap.factors %}
          <li>{{ f }}.</li>
          {%- endfor %}
        </ul>
        {% endif %}
        {% if game.recap.performers %}<p>{{ game.recap.performers }}</p>{% endif %}
        {% if game.knowable or game.recap.surprise.length %}
        <h4>Was it predictable?</h4>
        {% if game.knowable %}<p>{{ game.knowable }}</p>{% endif %}
        {%- for s in game.recap.surprise %}
        <p>{{ s }}</p>
        {%- endfor %}
        {% endif %}
        <p class="muted">Computed from the box score and the pregame line, not human judgment.</p>
      </section>
      {% endif %}

      <table>
        <caption class="visually-hidden">Season form comparison for {{ game.away.displayName }} and {{ game.home.displayName }}</caption>
        <thead>
          <tr>
            <th scope="col">Signal</th>
            <th scope="col">{{ game.away.abbreviation }} (away)</th>
            <th scope="col">{{ game.home.abbreviation }} (home)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Record</th>
            <td>{{ game.away.record or "–" }}</td>
            <td>{{ game.home.record or "–" }}</td>
          </tr>
          <tr>
            <th scope="row">Offense vs their defense</th>
            <td>{{ game.awayMatchup }}</td>
            <td>{{ game.homeMatchup }}</td>
          </tr>
          <tr>
            <th scope="row">Last 10 / streak</th>
            <td>{{ game.awayLastTen }}</td>
            <td>{{ game.homeLastTen }}</td>
          </tr>
          <tr>
            <th scope="row">Rest</th>
            <td>{{ game.awayRest }}</td>
            <td>{{ game.homeRest }}</td>
          </tr>
        </tbody>
      </table>

      {% if game.rankRows %}
      <h3>League rank, last 10 games (of {{ game.rankRows.of }})</h3>
      <table>
        <caption class="visually-hidden">League rank over the last 10 games for {{ game.away.displayName }} and {{ game.home.displayName }}, where 1st is best</caption>
        <thead>
          <tr>
            <th scope="col">Team strength</th>
            <th scope="col">{{ game.away.abbreviation }} (away)</th>
            <th scope="col">{{ game.home.abbreviation }} (home)</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in game.rankRows.rows %}
          <tr>
            <th scope="row">{{ row.label }}</th>
            <td>{{ row.away }}</td>
            <td>{{ row.home }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      <p class="muted">1st is best. Whole team, not just the starters.</p>
      {% endif %}

      {% if game.cohesion %}
      <h3>Cohesion</h3>
      <table>
        <caption class="visually-hidden">How long each team's projected starters have played together</caption>
        <thead>
          <tr>
            <th scope="col">Projected starters</th>
            <th scope="col">{{ game.away.abbreviation }} (away)</th>
            <th scope="col">{{ game.home.abbreviation }} (home)</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in game.cohesion.rows %}
          <tr>
            <th scope="row">{{ row.label }}</th>
            <td>{{ row.away }}</td>
            <td>{{ row.home }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      <p class="muted">Counts cover last season and this one, playoffs included.{% if game.cohesion.typicalPair %} A typical lineup's average pair this season: {{ game.cohesion.typicalPair }}.{% endif %} <a href="/insights/">Has cohesion predicted results?</a></p>
      {% endif %}

      {% if game.analyticsRows %}
      <h3>Last 10 analytics</h3>
      <table>
        <caption class="visually-hidden">Last ten games analytics for {{ game.away.displayName }} and {{ game.home.displayName }}</caption>
        <thead>
          <tr>
            <th scope="col">Signal</th>
            <th scope="col">{{ game.away.abbreviation }} (away)</th>
            <th scope="col">{{ game.home.abbreviation }} (home)</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in game.analyticsRows %}
          <tr>
            <th scope="row">{{ row.label }}</th>
            <td>{{ row.away }}</td>
            <td>{{ row.home }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      <p class="muted">Possession-adjusted, from each team's last 10 box scores. Opponent 3-point % is mostly luck and tends to regress.</p>
      {% endif %}

      {% if not game.isFinal %}
      <div class="injury-cols">
        {%- for side in [
          { nickname: game.away.shortDisplayName, starters: game.awayStarters, group: game.awayStartersGroup, unaccounted: game.awayUnaccounted },
          { nickname: game.home.shortDisplayName, starters: game.homeStarters, group: game.homeStartersGroup, unaccounted: game.homeUnaccounted }
        ] %}
        <section>
          <h3>{{ side.nickname }} starters</h3>
          {% if side.group %}<p><strong>{{ side.group }}</strong></p>{% endif %}
          {% if side.starters %}
          <ul>
            {%- for s in side.starters %}
            <li>
              <strong>{{ s.name }}</strong>{% if s.pos %} ({{ s.pos }}){% endif %}
              {% if s.projected %}<br>Projected to start in place of an injured starter{% elif s.newToLineup %}<br>Recently entered the starting lineup, often injury cover{% endif %}
              {% if s.gtdNote %}<br>{{ s.gtdNote | upperFirst }}{% endif %}
              {% if s.absenceNote %}<br><strong>{{ s.absenceNote | upperFirst }}</strong>{% endif %}
              {% if s.changedNote %}<br><span class="changed">{{ s.changedNote }}</span>{% endif %}
              {% if s.trend %}<br>{{ s.trend }}{% endif %}
              {% if s.indexLine %}<br>{{ s.indexLine }}{% endif %}
            </li>
            {%- endfor %}
          </ul>
          {% if side.unaccounted and side.unaccounted.length %}
          <p class="fact-lead"><strong>Also unaccounted for:</strong></p>
          <ul class="fact-list">
            {%- for u in side.unaccounted %}
            <li>{{ u.name }} {{ u.note }}.</li>
            {%- endfor %}
          </ul>
          </p>
          {% endif %}
          <p class="muted">100 is league average</p>
          {% else %}
          <p>Not enough completed games to read a {{ side.nickname }} lineup yet.</p>
          {% endif %}
        </section>
        {%- endfor %}
        {%- for side in [
          { nickname: game.away.shortDisplayName, inj: game.awayInjuries },
          { nickname: game.home.shortDisplayName, inj: game.homeInjuries }
        ] %}
        <div>
          {% if side.inj.count == 0 %}
          <p>No {{ side.nickname }} injuries listed.</p>
          {% else %}
          <details>
            <summary>{{ side.inj.count }} {{ side.nickname }} {% if side.inj.count == 1 %}injury{% else %}injuries{% endif %}{% if side.inj.changedCount %} ({{ side.inj.changedCount }} changed since your pick){% endif %}</summary>
            <ul>
              {%- for i in side.inj.all %}
              <li>
                <strong>{{ i.athlete }}</strong>{% if i.position %} ({{ i.position }}){% endif %}: {{ i.status }}{% if i.returnNote %} {{ i.returnNote }}{% endif %}
                {% if i.changedNote %}<br><span class="changed">{{ i.changedNote }}</span>{% endif %}
                {% if i.value %}<br>{{ i.value }}{% endif %}
                {% if i.context %}<br>{{ i.context }}{% endif %}
                {% if i.comment %}<br>{{ i.comment }}{% endif %}
              </li>
              {%- endfor %}
            </ul>
          </details>
          {% endif %}
        </div>
        {%- endfor %}
      </div>
      {% endif %}

      {% if game.collapseDetails %}
        {% if game.canEdit %}
        <form method="post" action="/predict/update" class="predict-form">
          <input type="hidden" name="predictionId" value="{{ game.myPick.id }}">
          <input type="hidden" name="gameId" value="{{ game.id }}">
          <input type="hidden" name="slateDate" value="{{ slate.ymd }}">
          <h3>Update your pick</h3>
          <fieldset>
            <legend>Who wins?</legend>
            <label>
              <input type="radio" name="pick" value="away" required{% if game.myPick.pick == "away" %} checked{% endif %}>
              {{ game.away.displayName }} (away)
            </label>
            <label>
              <input type="radio" name="pick" value="home" required{% if game.myPick.pick == "home" %} checked{% endif %}>
              {{ game.home.displayName }} (home)
            </label>
          </fieldset>
          <div class="field-row">
            <div class="field">
              <label for="margin-edit-{{ game.id }}">Predicted margin (points, optional)</label>
              <input id="margin-edit-{{ game.id }}" name="predictedMargin" type="number" inputmode="numeric" min="1" max="60" {% if game.myPick.margin %}value="{{ game.myPick.margin }}"{% endif %}>
            </div>
            <div class="field">
              <label for="confidence-edit-{{ game.id }}">Confidence (1 = coin flip, 5 = lock)</label>
              <select id="confidence-edit-{{ game.id }}" name="confidence" required>
                {%- for n in [1, 2, 3, 4, 5] %}
                <option value="{{ n }}"{% if game.myPick.confidence == n %} selected{% endif %}>{{ n }}</option>
                {%- endfor %}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="reasoning-edit-{{ game.id }}">Reasoning (required, this is what the retrospective checks)</label>
            <textarea id="reasoning-edit-{{ game.id }}" name="reasoning" rows="3" required minlength="10">{{ game.myPick.reasoning }}</textarea>
          </div>
          <button type="submit">Update my pick</button>
          <p class="muted">Updating refreshes the snapshot of the game data, so changes are measured from your latest decision.</p>
        </form>
        {% endif %}
      </details>
      {% elif game.canPredict %}
      <form method="post" action="/predict" class="predict-form">
        <input type="hidden" name="gameId" value="{{ game.id }}">
        <input type="hidden" name="slateDate" value="{{ slate.ymd }}">
        <h3>Log a prediction</h3>
        <fieldset>
          <legend>Who wins?</legend>
          <label>
            <input type="radio" name="pick" value="away" required>
            {{ game.away.displayName }} (away)
          </label>
          <label>
            <input type="radio" name="pick" value="home" required>
            {{ game.home.displayName }} (home)
          </label>
        </fieldset>
        <div class="field-row">
          <div class="field">
            <label for="margin-{{ game.id }}">Predicted margin (points, optional)</label>
            <input id="margin-{{ game.id }}" name="predictedMargin" type="number" inputmode="numeric" min="1" max="60">
          </div>
          <div class="field">
            <label for="confidence-{{ game.id }}">Confidence (1 = coin flip, 5 = lock)</label>
            <select id="confidence-{{ game.id }}" name="confidence" required>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3" selected>3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="reasoning-{{ game.id }}">Reasoning (required, this is what the retrospective checks)</label>
          <textarea id="reasoning-{{ game.id }}" name="reasoning" rows="3" required minlength="10"></textarea>
        </div>
        <button type="submit">Save prediction and snapshot inputs</button>
        <p class="muted">Saving keeps you on this page. Your pick appears on this card, and you can update it until tip-off.</p>
      </form>
      {% endif %}
    </article>
  </li>
  {%- endfor %}
</ul>
{% endif %}
