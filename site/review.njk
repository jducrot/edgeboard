---
layout: layout.njk
permalink: "/review/"
title: "Prediction review"
navCurrent: review
---
{% from "icons.njk" import resultIcon %}
<h1>Prediction review</h1>

<p>{{ journal.summary }}</p>
{% if journal.predictions.length > 0 %}
<p><a href="/export.csv">Download all your picks as a spreadsheet (CSV)</a></p>
{% endif %}

{% if journal.track %}
{% set t = journal.track %}
<section aria-labelledby="track-heading" class="card insight track">
  <h2 id="track-heading">Your track record</h2>
  <p>Your {{ t.graded }} graded {% if t.graded == 1 %}pick{% else %}picks{% endif %}, compared with the market and the stats on the same games.{% if t.early %} Early days: with fewer than 30 graded picks, these numbers can swing a lot.{% endif %}</p>
  {% macro trackTable(id, caption, first, rows) %}
  <div class="table-scroll" role="region" aria-labelledby="{{ id }}" tabindex="0">
  <table>
    <caption id="{{ id }}">{{ caption }}</caption>
    <thead>
      <tr>
        <th scope="col">{{ first }}</th>
        <th scope="col">Right</th>
        <th scope="col">Picks</th>
        <th scope="col">Context</th>
      </tr>
    </thead>
    <tbody>
      {%- for r in rows %}
      <tr>
        <th scope="row">{{ r.label }}</th>
        <td>{{ r.right }}</td>
        <td>{{ r.count }}</td>
        <td>{{ r.note or "–" }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
  </div>
  {% endmacro %}
  {{ trackTable("t-compare", "You against the market and the stats, on the same games", "Who picked", t.compare) }}
  {{ trackTable("t-sides", "Where your picks go right or wrong", "When", t.sides) }}
  {{ trackTable("t-confidence", "How often you were right at each confidence level", "Confidence", t.confidence) }}
  <p class="muted">A well-calibrated record is right more often at each step up in confidence. The market and the stats rows count only games where each had a pick.</p>
</section>
{% endif %}

{% if journal.predictions.length > 0 %}
<ul class="card-grid" role="list">
  {%- for p in journal.predictions %}
  <li>
    <article aria-labelledby="pred-{{ p.id }}-heading" class="card">
      <h2 id="pred-{{ p.id }}-heading">{{ p.gameLabel }}, {{ p.gameDateEt }}</h2>
      <p><strong>Pick:</strong> {{ resultIcon(p.outcome) }}{{ p.pickLine }}. <strong>Line at prediction:</strong> {{ p.lineAtPrediction }}</p>
      <p><strong>Result:</strong> {{ p.resultLine }}</p>
      <p><strong>Your reasoning:</strong> {{ p.reasoning }}</p>
      {% if p.syncNote %}<p><strong>Sync note:</strong> {{ p.syncNote }}</p>{% endif %}

      {% if p.snapshot %}
      <details>
        <summary>Inputs snapshotted at prediction time</summary>
        <dl>
          <div><dt>Line</dt><dd>{{ p.snapshot.line }}</dd></div>
          <div><dt>{{ p.snapshot.awayAbbr }} form</dt><dd>{{ p.snapshot.awayForm }}</dd></div>
          <div><dt>{{ p.snapshot.homeAbbr }} form</dt><dd>{{ p.snapshot.homeForm }}</dd></div>
          <div><dt>{{ p.snapshot.awayAbbr }} injuries</dt><dd>{{ p.snapshot.awayInjuries }}</dd></div>
          <div><dt>{{ p.snapshot.homeAbbr }} injuries</dt><dd>{{ p.snapshot.homeInjuries }}</dd></div>
        </dl>
      </details>
      {% endif %}

      {% if p.graded %}
      <section aria-label="Retrospective: {{ p.gameLabel }}" class="retro-done">
        <h3>Retrospective</h3>
        {% if p.autoRetroItems %}
        <ul class="fact-list">
          {%- for item in p.autoRetroItems %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        <p class="muted">Computed from your pick, the market line, the box score, and the live win-probability path.</p>
        {% else %}
        <p>Being generated; refresh in a moment.</p>
        {% endif %}
        {% if p.retroNotes %}
        <p><strong>Your notes:</strong> {{ p.retroNotes }}</p>
        {% else %}
        <form method="post" action="/retro" class="retro-form">
          <input type="hidden" name="predictionId" value="{{ p.id }}">
          <div class="field">
            <label for="notes-{{ p.id }}">Your notes (what would you track or weigh differently next time?)</label>
            <textarea id="notes-{{ p.id }}" name="notes" rows="3"></textarea>
          </div>
          <button type="submit">Save notes</button>
        </form>
        {% endif %}
      </section>
      {% endif %}
    </article>
  </li>
  {%- endfor %}
</ul>
{% endif %}
